# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NODE_ENV is set automatically by each Next.js command (dev/build/start) — never set it here.

# Database (docker-compose default — see docker-compose.yml)
DATABASE_URL=postgresql://condopilot:condopilot@localhost:55432/condopilot
# Free cloud alternative (no Docker needed): create a project at https://neon.tech and paste its
# connection string here instead — e.g. postgresql://user:pass@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Isolated DB for integration tests — keep this on the local Docker Postgres regardless of the
# above (disposable, no free-tier connection limits); never point it at dev or prod data.
TEST_DATABASE_URL=postgresql://condopilot:condopilot@localhost:55432/condopilot_test

# Authentication (generate with: npx auth secret)
AUTH_SECRET=

# LLM — "local" is a free, deterministic, no-API-key provider used by default (pattern-matches
# a fixed set of phrases, see src/agent/providers/local-heuristic.ts).
# Set to "openai-compatible" to use a real model with proper natural-language understanding and
# tool-calling, via any OpenAI-compatible Chat Completions API — tested with Groq's free tier:
#   1. create a free key at https://console.groq.com/keys
#   2. LLM_PROVIDER=openai-compatible
#   3. LLM_API_KEY=gsk_...
#   4. LLM_MODEL=openai/gpt-oss-20b   (or openai/gpt-oss-120b for higher quality, still free)
#   5. LLM_BASE_URL=https://api.groq.com/openai/v1
# The model only ever picks a tool + arguments — it never executes anything directly, and its
# output still goes through the exact same schema validation / authz / confirmation pipeline as
# the local provider. See src/agent/providers/openai-compatible.ts and docs/agent-contract.md.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Observability (optional, no-op if unset)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional integrations (never required for the demo)
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
