generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  MANAGER
  ADMIN
}

enum AgentTurnStatus {
  SUCCESS
  DENIED
  CLARIFY
  ERROR
  PENDING_CONFIRMATION
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

model Condominium {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  users User[]

  @@map("condominiums")
}

model User {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  name          String
  email         String      @unique
  passwordHash  String
  role          Role        @default(RESIDENT)
  unit          String?
  createdAt     DateTime    @default(now())

  @@index([condominiumId])
  @@map("users")
}

model AgentExecution {
  id            String          @id @default(cuid())
  condominiumId String
  userId        String
  input         String
  toolName      String?
  toolArgs      Json?
  status        AgentTurnStatus
  errorCode     String?
  latencyMs     Int
  createdAt     DateTime        @default(now())

  @@index([condominiumId, createdAt])
  @@map("agent_executions")
}

model Charge {
  id            String    @id @default(cuid())
  condominiumId String
  userId        String
  description   String
  amountCents   Int
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([condominiumId])
  @@index([userId])
  @@map("charges")
}

model CommonArea {
  id            String   @id @default(cuid())
  condominiumId String
  name          String
  createdAt     DateTime @default(now())

  reservations Reservation[]

  @@index([condominiumId])
  @@map("common_areas")
}

model Reservation {
  id            String            @id @default(cuid())
  condominiumId String
  commonAreaId  String
  commonArea    CommonArea        @relation(fields: [commonAreaId], references: [id], onDelete: Cascade)
  userId        String
  startsAt      DateTime
  endsAt        DateTime
  status        ReservationStatus @default(CONFIRMED)
  note          String?
  createdAt     DateTime          @default(now())
  cancelledAt   DateTime?

  @@index([condominiumId])
  @@index([commonAreaId, startsAt, endsAt])
  @@map("reservations")
}

model Notification {
  id              String   @id @default(cuid())
  condominiumId   String
  recipientUserId String
  sentByUserId    String
  channel         String
  subject         String
  body            String
  sentAt          DateTime @default(now())

  @@index([condominiumId])
  @@index([recipientUserId])
  @@map("notifications")
}
